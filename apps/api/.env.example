# Copy to .env and adjust. Every variable is validated at boot (src/config/env.ts).

NODE_ENV=development

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# PostgreSQL
DATABASE_URL=postgres://swifty:swifty@localhost:5432/swifty

# Redis (queues, cache)
REDIS_URL=redis://localhost:6379

# 32+ char random secret for signing tokens; generate with: openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me
