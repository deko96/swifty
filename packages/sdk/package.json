{
  "name": "@swifty/sdk",
  "version": "0.1.0",
  "description": "Typed contract for Swifty panel modules: manifests, lifecycle hooks, and core events.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
